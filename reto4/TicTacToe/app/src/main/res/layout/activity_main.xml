<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="TRIQUI"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/tablero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:columnCount="3"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">


        <Button
            android:id="@+id/boton0"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton4"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton5"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton6"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton7"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

        <Button
            android:id="@+id/boton8"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/celda"
            android:backgroundTint="@null"
            android:text=""
            android:textSize="42sp" />

    </GridLayout>

    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Tu turno"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tablero" />

    <LinearLayout
        android:id="@+id/contador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEstado">

        <TextView
            android:id="@+id/contadorJugador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="25dp"
            android:text="Tú: 0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contadorEmpates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="25dp"
            android:text="Empates: 0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/contadorComputadora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC: 0"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/botonNuevaPartida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Nueva partida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contador" />

</androidx.constraintlayout.widget.ConstraintLayout>